{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OutputTemplate",
  "type": "object",
  "required": ["schema_version", "id", "type", "name", "format"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0"]},
    "id": {"type": "string", "pattern": "^OUT-[a-z0-9-]+$"},
    "type": {"type": "string", "enum": ["output_template"]},
    "name": {"type": "string", "minLength": 1, "maxLength": 200},
    "format": {
      "type": "string",
      "enum": ["pptx", "docx", "pdf", "md", "xlsx", "html", "txt"]
    },
    "description": {"type": "string"},
    "required_sections": {
      "type": "array",
      "items": {"type": "string"}
    },
    "style_guide": {"type": "string"},
    "tags": {"type": "array", "items": {"type": "string"}},
    "examples": {
      "type": "array",
      "items": {"type": "string"}
    },
    "claude_instructions": {"type": "string"}
  },
  "additionalProperties": false
}
