{
  "name": "@bertonha/getthingsdone",
  "version": "0.7.0",
  "description": "Get Things Done — a local GTD workspace for executives. Kanban dashboard over plain Markdown files, with AI agent integration.",
  "keywords": [
    "gtd",
    "get-things-done",
    "executive",
    "productivity",
    "kanban",
    "workspace",
    "markdown",
    "claude",
    "claude-code",
    "copilot",
    "ai-agents"
  ],
  "license": "MIT",
  "bin": {
    "gtd": "./bin/gtd.js",
    "esb": "./bin/gtd.js"
  },
  "main": "dist/cli/index.js",
  "files": [
    "bin/",
    "dist/",
    "templates/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=ui\"",
    "build:clean": "node scripts/build-utils.mjs clean dist",
    "build:cli": "tsc -p tsconfig.json",
    "desktop": "npm run build && npm start --prefix desktop",
    "build:server": "npm run build --workspace=server",
    "build:ui": "npm run build --workspace=ui",
    "build:copy-ui": "node scripts/build-utils.mjs copy ui/dist dist/ui",
    "build:copy-server": "node scripts/build-utils.mjs copy server/dist dist/server",
    "build": "npm run build:clean && npm run build:server && npm run build:ui && npm run build:cli && npm run build:copy-ui && npm run build:copy-server",
    "start": "npm run start --workspace=server",
    "test": "npm run test:harness && npm run test:unit && npm run test:smoke",
    "test:unit": "npm run test --workspace=server && npm run test:agent-floor --workspace=ui && npm run test:org-chart --workspace=ui && npm run test:files --workspace=ui && npm run test:calendar --workspace=ui && npm run test:diff --workspace=ui && npm run test:meeting-prep --workspace=ui && npm run test:review-choices --workspace=ui && npm run test:meeting-action --workspace=ui && npm run test:desktop-bridge --workspace=ui && npm run test:setup --workspace=ui && npm run test:icon-crop --workspace=ui && npm run test:desktop",
    "test:desktop": "tsx --test desktop/tests/*.test.ts",
    "test:smoke": "node scripts/smoke-test.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed:demo": "node scripts/seed-demo.mjs",
    "prepublishOnly": "npm run build",
    "test:harness": "node scripts/check-boundaries.mjs"
  },
  "workspaces": [
    "server",
    "ui"
  ],
  "dependencies": {
    "@inquirer/prompts": "^7.2.0",
    "@simple-git/argv-parser": "2.0.1",
    "ajv": "^8.12.0",
    "ajv-formats": "^3.0.1",
    "chalk": "^5.6.2",
    "chokidar": "^5.0.0",
    "commander": "^12.1.0",
    "cors": "^2.8.5",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "gray-matter": "^4.0.3",
    "helmet": "^8.3.0",
    "morgan": "^1.10.0",
    "multer": "^2.5.0",
    "open": "^11.0.4",
    "ora": "^9.4.1",
    "sherpa-onnx-node": "2.0.1",
    "simple-git": "^4.0.2",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.11.30",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.4.3",
    "typescript-eslint": "^8.72.1"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "author": "Geovanne Bertonha",
  "homepage": "https://github.com/geovanneb/get-things-done#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geovanneb/get-things-done.git"
  },
  "bugs": {
    "url": "https://github.com/geovanneb/get-things-done/issues"
  },
  "overrides": {
    "body-parser": "^1.20.9",
    "qs": "^6.15.4"
  }
}
